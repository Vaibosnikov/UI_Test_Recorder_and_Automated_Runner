{
  "manifest_version": 3,
  "name": "TestCraft Recorder",
  "version": "1.0.0",
  "description": "Records UI interactions for TestCraft automated testing",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "src/ui/popup.html"
  },
  "background": {
    "service_worker": "src/background/background.js"
  }
}
