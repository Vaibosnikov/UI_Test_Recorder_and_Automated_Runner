import React, { useState, useEffect } from "react";
import mock from "../mock/samplerun.json"; // adjust path as needed

export default function SampleRun() {
  const [runs, setRuns] = useState([]);
  const [loading, setLoading] = useState(true);

  // Load and map mock data when the component mounts
  useEffect(() => {
    const rawData = mock.data && mock.data.length ? mock.data : [];
    const mappedRuns = rawData.map(r => ({
      id: r.id,
      testId: r.test_id,
      status: r.status,
      environment: r.environment,
      branch: r.branch,
      duration: r.duration_ms,
      startedAt: r.started_at,
    }));
    setRuns(mappedRuns);
    setLoading(false);
  }, []);

  if (loading) return <div>Loading...</div>;

  return (
    <div className="p-4 bg-gray-100 rounded-lg">
      <h2 className="text-lg font-semibold mb-3">Sample Runs</h2>
      <ul>
        {runs.map(run => (
          <li key={run.id} className="mb-2 p-2 bg-white rounded shadow-sm">
            <div><strong>Test ID:</strong> {run.testId}</div>
            <div><strong>Status:</strong> {run.status}</div>
            <div><strong>Branch:</strong> {run.branch}</div>
            <div><strong>Environment:</strong> {run.environment}</div>
            <div><strong>Duration:</strong> {run.duration} ms</div>
            <div><strong>Started At:</strong> {new Date(run.startedAt).toLocaleString()}</div>
          </li>
        ))}
      </ul>
    </div>
  );
}
